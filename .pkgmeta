package-as: MuscleMemory

# CHANGELOG-latest.md is generated in CI with only the released version's notes.
manual-changelog:
  filename: CHANGELOG-latest.md
  markup-type: markdown

ignore:
  - .devcontainer
  - .github
  - .gitignore
  - .luacheckrc
  - .release
  - CONTRIBUTING.md
  - README.md
  - scripts
  - spec
  - stylua.toml
  - luacov.report.out
  - design
  - docs
  - Assets/*.png
